// -----------------------------------------------------------------------------
// Builds the Vue chat UI (webview/**) that is shown inside the VSCode sidebar.
//
// The webview HTML is generated by the extension (src/webviewHtml.ts), not
// taken from Vite's output, because it needs a per-load security nonce and
// VSCode-specific resource URLs. So Vite only has to produce one JS file and
// one CSS file with *fixed* names that the extension can reference.
// -----------------------------------------------------------------------------
import vue from "@vitejs/plugin-vue";
import { defineConfig } from "vite";

export default defineConfig({
  root: "webview",
  plugins: [vue()],
  build: {
    outDir: "../dist/webview",
    emptyOutDir: true,
    // Put all CSS in one file instead of splitting it per component.
    cssCodeSplit: false,
    // The modulepreload polyfill injects an inline script, which the webview's
    // Content Security Policy would block, and we don't need it anyway.
    modulePreload: false,
    sourcemap: true,
    rolldownOptions: {
      output: {
        // Stable file names (no content hashes) so webviewHtml.ts can find them.
        entryFileNames: "assets/index.js",
        chunkFileNames: "assets/[name].js",
        // The only asset is the single CSS file, so it is always named index.css.
        assetFileNames: "assets/index[extname]",
      },
    },
  },
});
